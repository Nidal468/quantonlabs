# Assessment: signed report and brief links (DEVELOPER BRIEF ASSESSMENT, Launch Blocker 1)
# 32+ random characters. Rotating it voids every issued report and brief link.
REPORT_LINK_SECRET=

# Private Blob store (ql-assessment-private) for reports and briefs.
# Vercel sets BLOB_STORE_ID and VERCEL_OIDC_TOKEN when the store is connected;
# `vercel env pull .env.local` brings both down for local development.
# The public store (brand assets) keeps its own BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
