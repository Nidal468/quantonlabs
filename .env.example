# Assessment: signed report and brief links (DEVELOPER BRIEF ASSESSMENT, Launch Blocker 1)
# 32+ random characters. Rotating it voids every issued report and brief link.
REPORT_LINK_SECRET=

# Private Blob store (ql-assessment-private) for reports and briefs.
# Vercel sets BLOB_STORE_ID and VERCEL_OIDC_TOKEN when the store is connected;
# `vercel env pull .env.local` brings both down for local development.
# The public store (brand assets) keeps its own BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=

# Vercel cron authorization for /api/cron/retention
CRON_SECRET=

# Absolute site address for report, brief, and email links. Optional:
# defaults to https://quantonlabs.com. Set it on preview deployments to test links there.
NEXTAUTH_URL=https://quantonlabs.com

# Already set in Vercel: Google service account, Sheet, and Gmail sender
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHEET_ID=
# GMAIL_SEND_AS=growth@quantonlabs.com
